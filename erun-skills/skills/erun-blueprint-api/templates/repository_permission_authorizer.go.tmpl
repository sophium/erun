package repository

import (
	"context"
	"database/sql"
)

// PermissionAuthorizer matches the request's (method, apiPath) against
// the role_permissions rows assigned to the user via user_roles. The
// canonical apiPath is the route template (e.g. "/v1/invoices/{invoice_id}"),
// not the concrete URL.
//
// Two permission shapes are supported:
//   - exact: WHERE api_method = $1 AND api_path = $2
//   - regex: WHERE api_method_pattern ~ $1 AND api_path_pattern ~ $2
//
// Predefined roles (ReadAll, WriteAll) use the regex shape with broad
// patterns. Custom roles typically use the exact shape.
type PermissionAuthorizer struct {
	db      *sql.DB
	dialect Dialect
}

func NewPermissionAuthorizerForDialect(db *sql.DB, dialect Dialect) *PermissionAuthorizer {
	return &PermissionAuthorizer{db: db, dialect: dialect}
}

// IsAllowed returns true when the user has any role granting the given
