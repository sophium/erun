package main

import (
	"context"
	"database/sql"
	"errors"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"strings"
	"syscall"
	"time"

	"github.com/uptrace/bun/driver/pgdriver"

	api "__MODULE_PATH__"
	"__MODULE_PATH__/internal/repository"
)

func main() {
	logger := slog.New(slog.NewJSONHandler(os.Stderr, nil))

	databaseURL := os.Getenv("DATABASE_URL")
	if databaseURL == "" {
		logger.Error("DATABASE_URL is required")
		os.Exit(2)
	}

	issuers := strings.Split(os.Getenv("OIDC_ISSUERS"), ",")
	for i := range issuers {
		issuers[i] = strings.TrimSpace(issuers[i])
	}
	if len(issuers) == 0 || (len(issuers) == 1 && issuers[0] == "") {
		logger.Error("OIDC_ISSUERS is required (comma-separated)")
		os.Exit(2)
	}

	listenAddr := os.Getenv("LISTEN_ADDR")
	if listenAddr == "" {
		listenAddr = ":8080"
	}

	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	db := sql.OpenDB(pgdriver.NewConnector(pgdriver.WithDSN(databaseURL)))
	defer db.Close()

	verifier, err := api.NewMultiIssuerVerifier(ctx, issuers)
	if err != nil {
		logger.Error("oidc verifier setup failed", "err", err)
		os.Exit(1)
	}

	handler, err := api.NewHandler(api.HandlerOptions{
		TokenVerifier: verifier,
		DB:            db,
		DBDialect:     repository.DialectPostgres,
		IdentityCache: api.NewIdentityResolutionCache(api.IdentityCacheOptions{
			PositiveTTL: 5 * time.Minute,
			NegativeTTL: 30 * time.Second,
			MaxEntries:  10000,
		}),
	})
	if err != nil {
		logger.Error("handler construction failed", "err", err)
		os.Exit(1)
	}

	server := &http.Server{
		Addr:              listenAddr,
		Handler:           handler,
		ReadHeaderTimeout: 5 * time.Second,
	}
	go func() {
		<-ctx.Done()
		shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		if err := server.Shutdown(shutdownCtx); err != nil {
			logger.Error("shutdown failed", "err", err)
		}
	}()

	logger.Info("listening", "addr", listenAddr)
	if err := server.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
		logger.Error("server failed", "err", err)
		os.Exit(1)
	}
}
