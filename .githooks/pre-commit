#!/usr/bin/env sh
# Formats staged files and re-stages them. Lint and tests run in each
# component's own build (`erun build`), not here.
set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$STAGED" ] || exit 0

STAGED_GO=$(printf '%s\n' "$STAGED" | grep -E '\.go$' || true)
if [ -n "$STAGED_GO" ]; then
  printf '%s\n' "$STAGED_GO" | tr '\n' '\0' | xargs -0 gofmt -w
  printf '%s\n' "$STAGED_GO" | tr '\n' '\0' | xargs -0 git add
fi

# Each prettier project formats from its own directory so its .prettierrc.json
# and .prettierignore apply. erun-console/playwright is its own project.
PRETTIER="$REPO_ROOT/node_modules/.bin/prettier"
for project in erun-kit erun-console erun-console/playwright erun-ui/frontend erun-ui/playwright; do
  files=$(printf '%s\n' "$STAGED" | grep -E "^$project/" || true)
  if [ "$project" = erun-console ]; then
    files=$(printf '%s\n' "$files" | grep -vE '^erun-console/playwright/' || true)
  fi
  [ -n "$files" ] || continue
  if [ ! -x "$PRETTIER" ]; then
    echo "note: root node_modules missing; skipping prettier (run 'yarn install' at the repo root)" >&2
    break
  fi
  printf '%s\n' "$files" | sed "s|^$project/||" | tr '\n' '\0' |
    (cd "$project" && xargs -0 "$PRETTIER" --write --ignore-unknown --log-level warn)
  printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 git add
done
