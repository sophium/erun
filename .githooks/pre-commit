#!/usr/bin/env sh
# Formats staged files and re-stages them. Lint and tests run in each
# component's own build (`erun build`), not here.
set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$STAGED" ] || exit 0

# gofmt's alignment differs between Go releases, and each component lints
# under the toolchain its go.mod pins, so each file is formatted by the gofmt
# of the go version its own module declares rather than whatever go is first
# on PATH.
module_gofmt() {
  dir=$(dirname "$1")
  while [ "$dir" != "." ] && [ "$dir" != "/" ] && [ ! -f "$dir/go.mod" ]; do
    dir=$(dirname "$dir")
  done
  version=$(sed -n 's/^go \([0-9][0-9.]*\)$/\1/p' "$dir/go.mod" 2>/dev/null | head -n 1)
  if [ -n "$version" ] && root=$(GOTOOLCHAIN="go$version" go env GOROOT 2>/dev/null); then
    printf '%s\n' "$root/bin/gofmt"
    return
  fi
  echo "note: could not resolve the go$version toolchain for $1; formatting with the gofmt on PATH" >&2
  printf '%s\n' gofmt
}

STAGED_GO=$(printf '%s\n' "$STAGED" | grep -E '\.go$' || true)
if [ -n "$STAGED_GO" ]; then
  printf '%s\n' "$STAGED_GO" | while IFS= read -r file; do
    "$(module_gofmt "$file")" -w "$file"
  done
  printf '%s\n' "$STAGED_GO" | tr '\n' '\0' | xargs -0 git add
fi

# Each prettier project formats from its own directory so its .prettierrc.json
# and .prettierignore apply. erun-console/playwright is its own project.
PRETTIER="$REPO_ROOT/node_modules/.bin/prettier"
for project in erun-kit erun-console erun-console/playwright erun-ui/frontend erun-ui/playwright; do
  files=$(printf '%s\n' "$STAGED" | grep -E "^$project/" || true)
  if [ "$project" = erun-console ]; then
    files=$(printf '%s\n' "$files" | grep -vE '^erun-console/playwright/' || true)
  fi
  [ -n "$files" ] || continue
  if [ ! -x "$PRETTIER" ]; then
    echo "note: root node_modules missing; skipping prettier (run 'yarn install' at the repo root)" >&2
    break
  fi
  printf '%s\n' "$files" | sed "s|^$project/||" | tr '\n' '\0' |
    (cd "$project" && xargs -0 "$PRETTIER" --write --ignore-unknown --log-level warn)
  printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 git add
done
