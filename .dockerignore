# Keep the build context lean and stable. Mirrors .gitignore plus VCS,
# IDE, and tooling state that must never enter the image or perturb cache keys.

# Version control / hooks
.git
.githooks
.github

# IDE / editor / agent state
.idea
.vscode
.claude
.codex
.erun

# Go build artifacts and test output
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
__debug_bin*
.gomodcache

# Integration-suite local artifacts (regenerated per run; must not enter the
# build context or perturb fingerprint cache keys)
/erun-integration/coverage
/erun-integration/bin

# Local packaging / release artifacts
/packaging/apt/dist
/erun-devops/linux/*/dist
/erun-cli/bin

# Desktop UI build outputs (not consumed by service Dockerfiles)
/erun-ui/bin
/erun-ui/frontend/node_modules
/erun-ui/frontend/dist
/erun-ui/frontend/wailsjs
/erun-ui/playwright/node_modules
/erun-ui/playwright/test-results
/erun-ui/playwright/playwright-report
/erun-ui/.golangci-cache

# Docs site dependencies and build outputs. The erun-docs image runs
# `yarn install` + `yarn build` inside its Dockerfile, so these are
# regenerated in-image and must never enter the build context: they bloat it
# (~1GB of node_modules alone) and, because the build only honours this root
# .dockerignore while the fingerprint also honours erun-docs/.gitignore, their
# presence diverges the real context from the fingerprint.
/erun-docs/node_modules
/erun-docs/build
/erun-docs/.docusaurus
/erun-docs/.cache-loader

# Env files
.env
