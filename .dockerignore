# Keep the build context lean and fingerprint-stable: .gitignore plus VCS, IDE and tooling state.

# Version control / hooks
.git
.githooks
.github

# IDE / editor / agent state
.idea
.vscode
.claude
.codex
# config.yaml is tracked and read by the cli-test stage; a bare .erun exclusion could not re-include it.
.erun/*
!.erun/config.yaml
# The fingerprint honours nested .gitignores; mirror them so the real context matches it.
**/.DS_Store

# Provider binaries from a hand-run `terraform init`; the fingerprint already ignores them.
**/.terraform/
**/.terraform.lock.hcl

# Go build artifacts and test output
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
__debug_bin*
.gomodcache

# Integration-suite local artifacts
/erun-integration/coverage
/erun-integration/bin

# eslint/prettier --cache output
/.cache/

# Local packaging / release artifacts
/erun-devops/linux/*/dist
/erun-cli/bin

# Desktop UI build outputs; wailsjs is regenerated in-image, so a stale host copy must stay out.
/erun-ui/bin
/erun-ui/build/bin
# Local macOS desktop build output (~90MB) that no Linux build consumes.
/erun-ui/ERun.app
/erun-ui/darwin
/erun-ui/frontend/node_modules
/erun-ui/frontend/dist
/erun-ui/frontend/wailsjs
/erun-ui/frontend/*.tsbuildinfo
/erun-ui/frontend/package.json.md5
/erun-ui/playwright/node_modules
/erun-ui/playwright/test-results
/erun-ui/playwright/playwright-report
/erun-ui/playwright/playwright/.cache
/erun-ui/.golangci-cache

# Root yarn workspace deps and outputs, regenerated in-image by the console and UI Dockerfiles.
/node_modules
/erun-kit/node_modules
/erun-kit/dist
/erun-kit/.vite
/erun-kit/**/*.local
/erun-console/node_modules
/erun-console/dist
/erun-console/.vite
/erun-console/**/*.local
/erun-console/playwright/node_modules
/erun-console/playwright/test-results
/erun-console/playwright/playwright-report
/erun-console/playwright/.cache*
/erun-devops/e2e/*/node_modules
/erun-devops/e2e/*/test-results
/erun-devops/e2e/*/playwright-report

# Regenerated in-image by the erun-docs Dockerfile; docker ignores erun-docs/.gitignore, the fingerprint does not.
/erun-docs/node_modules
/erun-docs/build
/erun-docs/.docusaurus
/erun-docs/.cache-loader

# Env files
.env
