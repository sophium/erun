# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# env file
.env

# eslint/prettier --cache output (Makefile's test-frontend target,
# FRONTEND_LINT_CACHE_DIR)
/.cache/

.claude

# macOS
.DS_Store

# Editor/IDE
.idea/
# .vscode/
/.codex

# Delve debug binaries
__debug_bin*

.gomodcache
/packaging/apt/dist/
/erun-devops/linux/**/dist/
/erun-cli/bin/

# Playwright MCP debugging artifacts (console logs, page snapshots) written
# at the repo root by the local dev tooling, never by tests
/.playwright-mcp/
# Landing-layout Playwright runs drop a local HTTP server log here. It is a
# run artifact with timestamps and request lines, never a source file; the
# console's counterpart of erun-ui/playwright's `playwright/.cache/` rule.
**/.cache-landing-layout/


# Terraform init artifacts written by a local `terraform init`/`validate`,
# never shipped from the reusable modules.
**/.terraform/
# `.terraform.lock.hcl` is deliberately NOT ignored. It used to be, on the
# reading that a lock file is init output; but a module's `tests/*.tftest.hcl`
# is run by `terraform test` *in that module directory*, which makes the module
# its own root for that run, and `make check-gate`'s terraform-module-tests
# target runs those tests -- so the lock file is the pin that decides which
# provider versions the gate tested, and an unpinned gate would test whatever
# the registry published that morning. Committing it changes nothing for a
# consumer: terraform reads the lock file of the root module it is invoked in,
# never a child module's. scripts/terraform-module-test.sh refuses to run a
# tested module without one, and runs init with -lockfile=readonly so a
# constraint that no longer matches the recorded selection fails the gate
# instead of silently rewriting the pin.

# Compiled DNS-01 webhook binary from a local `go build` in the module dir.
/erun-devops/dns01-webhook/dns01-webhook

# Yarn workspaces hoist shared frontend deps into the repo-root node_modules.
/node_modules/
